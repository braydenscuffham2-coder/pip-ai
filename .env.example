# Everything is optional. With none of these set, the example walkthrough and
# the facts-only scan still work.

# Claude writes the personalized report, the demo receptionist and Ask Pip.
ANTHROPIC_API_KEY=
# Model overrides (defaults live in lib/server/llm.ts).
PIP_FAST_MODEL=
PIP_SMART_MODEL=

# Google Places (New): the business's listing, recent reviews and nearby competitors.
GOOGLE_PLACES_API_KEY=

# Supabase: scan cache, leads and events, reached only through locked-down database functions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PIP_SERVER_SECRET=

# Older review history through DataForSEO. Inactive until both are set.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Admin token for publishing skill specs (scripts/activate.mjs, /api/specs).
PIP_ADMIN_TOKEN=
# Base URL scripts/activate.mjs talks to.
PIP_SERVER=
# Optional webhook pinged when a lead comes in.
LEAD_NOTIFY_WEBHOOK=
# Set to 1 to force stand-in data everywhere.
PIP_PREVIEW_ONLY=
